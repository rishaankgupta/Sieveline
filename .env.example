# Copy to .env.local (development) or set in your host's secret manager (production).
# Never commit real values.

# --- App
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Database
DATABASE_URL=postgres://targetfinder:targetfinder@localhost:5432/targetfinder

# --- Research providers
TAVILY_API_KEY=
# Any OpenAI-compatible endpoint
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Spend safety (credits)
GLOBAL_DAILY_TAVILY_CREDIT_LIMIT=2000
DEFAULT_WORKSPACE_MONTHLY_CREDIT_CAP=1000

# --- Auth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability
SENTRY_DSN=
