# Copy to .env.local (development) or set in your host's secret manager (production).
# Never commit real values.

# --- App
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ random bytes, base64. Generate: openssl rand -base64 32
AUTH_SECRET=

# --- Database (Neon)
# Pooled connection string for the app
DATABASE_URL=
# Direct (unpooled) connection string for migrations
DATABASE_URL_UNPOOLED=

# --- Research providers
TAVILY_API_KEY=
# LLM provider is chosen later (D4). Set provider name, key and model ids.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
# Model for scoring with quotes (cheap, reliable JSON)
LLM_MODEL_SCORING=
# Model for the Advisor chat
LLM_MODEL_CHAT=

# --- Spend safety (credits)
GLOBAL_DAILY_TAVILY_CREDIT_LIMIT=2000
DEFAULT_WORKSPACE_MONTHLY_CREDIT_CAP=1000
# Max Tavily Research (deep dive) credits per request without extra confirmation
DEEP_DIVE_MAX_CREDITS=110

# --- Auth providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# --- Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Observability
SENTRY_DSN=

# --- Cloudflare (ADR-0006)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Admin
# Comma-separated emails allowed to become platform owner on first sign-in (2FA required)
PLATFORM_OWNER_EMAILS=
# Optional comma-separated IPs/CIDRs allowed to open /admin
ADMIN_IP_ALLOWLIST=
